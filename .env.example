# Server-side only (set these in Vercel Project Settings -> Environment Variables)
THIRD_PARTY_API_BASE_URL=https://api.example.com
THIRD_PARTY_API_TOKEN=replace-me

# Optional local direct mode for Vite dev only.
# WARNING: VITE_* values are exposed to the browser. Use temporary/sandbox tokens only.
VITE_USE_DIRECT_API=false
VITE_DIRECT_API_BASE_URL=https://api.example.com
VITE_DIRECT_API_TOKEN=replace-me
